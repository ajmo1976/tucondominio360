# TuCondominio360 API - variables de entorno
# Copiar a .env y ajustar.

PORT=3001
NODE_ENV=development

# --- Base de datos (Docker local) ---
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_USER=postgres
DATABASE_PASSWORD=postgrespassword
DATABASE_NAME=tucondominio360

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- JWT ---
JWT_SECRET=cambia_esto_en_produccion
JWT_EXPIRATION=7d

# --- Aplicación (para enlaces de correo) ---
WEB_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000

# --- Correo (nodemailer) ---
# MAIL_MODE=log  -> no envía; imprime el enlace en el log de la API (dev).
# MAIL_MODE=smtp -> envía por SMTP (requiere SMTP_HOST, etc.).
MAIL_MODE=log
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=TuCondominio360 <no-reply@tucondominio360.local>

# Exigir correo verificado para iniciar sesión (true en producción).
MAIL_VERIFY_REQUIRED=false

# --- Google OAuth (login con Google) ---
# Crear credenciales en https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback
